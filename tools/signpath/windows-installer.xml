<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "windows-installer" (docs/DISTRIBUTION.md).
  release.yml's Windows job uploads the Inno Setup installer once it has been
  compiled around the signed executables. SignPath can't open an Inno Setup
  installer to sign what is inside it, which is why the executables go first,
  in "windows-executables".
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="DoubleClickFixer-Setup.exe" product-name="Mouse Double-Click Fixer" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
