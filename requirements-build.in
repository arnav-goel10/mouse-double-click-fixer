# What CI and the build scripts install: the app's own pins plus the tools
# that package it. requirements-build.txt is generated from this file, with
# every version pinned and every file's hash, so a build installs exactly
# these files or nothing. Regenerate it after changing either file:
#
#   uv pip compile requirements-build.in --universal --generate-hashes \
#     --python-version 3.11 --no-header -o requirements-build.txt
-r requirements.txt
pyinstaller==6.22.3
pyinstaller-hooks-contrib==2026.8
dmgbuild==1.6.7; sys_platform == "darwin"
